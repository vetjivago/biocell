generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Organização e Unidades ──────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  units     Unit[]
  users     User[]
}

model Unit {
  id            String    @id @default(cuid())
  name          String
  city          String
  state         String
  // Endereço montado a partir dos campos abaixo (usado nas impressões de OS e orçamento)
  address       String?
  // Primeiro telefone/celular da lista (usado nas impressões)
  phone         String?
  species       String
  active        Boolean   @default(true)
  inactivatedAt DateTime?

  // Dados cadastrais (faturamento e acompanhamento jurídico/fiscal)
  cnpj                 String? // só dígitos
  legalName            String? // razão social
  tradeName            String? // nome fantasia
  legalNature          String? // natureza jurídica (ex.: 206-2 - Sociedade Empresária Limitada)
  legalCategory        String? // categoria jurídica (porte): ver LEGAL_CATEGORIES em src/lib/units.ts
  stateRegistration    String? // inscrição estadual
  shareCapital         Decimal?     @db.Decimal(15, 2)
  zipCode              String? // CEP, só dígitos
  street               String?
  number               String?
  complement           String?
  district             String?
  phones               String[]     @default([])
  mobiles              String[]     @default([])
  emails               String[]     @default([])
  billingEmails        String[]     @default([]) // e-mails de faturamento (envio de NF/boletos)
  financeEmails        String[]     @default([]) // e-mails do financeiro
  // Prontuário clínico geral (habilitado por unidade; inicialmente só Águas Claras)
  generalRecordEnabled Boolean      @default(false)
  // Ordem de serviço para o preparo das células (inicialmente só Águas Claras)
  serviceOrderEnabled  Boolean      @default(false)
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  createdAt            DateTime     @default(now())

  users                 UserUnit[]
  patients              Patient[]
  medicalRecords        MedicalRecord[]
  inventoryTransactions InventoryTransaction[]
  stockThresholds       StockThreshold[]
  alerts                Alert[]
  shipmentsSent         Shipment[]             @relation("ShipmentFrom")
  shipmentsReceived     Shipment[]             @relation("ShipmentTo")
  clinicalEntries       ClinicalEntry[]
  serviceOrders         ServiceOrder[]
  sales                 Sale[]
  documents             UnitDocument[]

  @@index([organizationId])
}

// Documentos da unidade (Cartão CNPJ, Contrato Social, Contrato UABC e outros), cada um com vários anexos
model UnitDocument {
  id          String    @id @default(cuid())
  unitId      String
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // CNPJ_CARD, SOCIAL_CONTRACT, UABC_CONTRACT (criados com a unidade) ou OTHER
  kind        String    @default("OTHER")
  name        String
  notes       String?
  dueDate     DateTime?
  // PUBLIC: todos que veem a ficha da unidade; RESTRICTED: só matriz e administrativo
  visibility  String    @default("PUBLIC")
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  attachments UnitDocumentAttachment[]

  @@index([unitId])
}

model UnitDocumentAttachment {
  id           String       @id @default(cuid())
  documentId   String
  document     UnitDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  createdAt    DateTime     @default(now())

  @@index([documentId])
}

// ── Usuários e Permissões ───────────────────────────────────────

model User {
  id                 String       @id @default(cuid())
  name               String
  // Login por e-mail ou celular: pelo menos um dos dois
  email              String?      @unique
  // Celular só com dígitos, DDD + número (ex.: 61999998888)
  phone              String?      @unique
  passwordHash       String
  role               String
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  active             Boolean      @default(true)
  // Senha provisória (criada/redefinida pela matriz ou gestor): obriga a trocar no próximo login
  mustChangePassword Boolean      @default(false)
  // Excluído pela matriz/gestor: some das listas e não entra mais; o nome continua no histórico clínico
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())

  units           UserUnit[]
  medicalRecords  MedicalRecord[]
  auditLogs       AuditLog[]
  clinicalEntries ClinicalEntry[]
  serviceOrders   ServiceOrder[]
  salesCreated    Sale[]          @relation("SaleCreatedBy")
  salesSold       Sale[]          @relation("SaleSoldBy")

  @@index([organizationId])
}

model UserUnit {
  id     String @id @default(cuid())
  userId String
  unitId String
  user   User   @relation(fields: [userId], references: [id])
  unit   Unit   @relation(fields: [unitId], references: [id])

  @@unique([userId, unitId])
  @@index([unitId])
}

// ── Pacientes (Animais) ─────────────────────────────────────────

model Patient {
  id           String    @id @default(cuid())
  name         String
  serialNumber String?
  species      String
  breed        String?
  weight       Float?
  ownerName    String
  ownerPhone   String?
  ownerEmail   String?
  veterinarian String?
  clinic       String?
  sex          String?
  neutered     Boolean   @default(false)
  coat         String?
  birthDate    DateTime?
  microchip    String?
  ownerAddress String?
  ownerCpf     String?
  unitId       String
  unit         Unit      @relation(fields: [unitId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  photo           PatientPhoto?
  medicalRecords  MedicalRecord[]
  clinicalEntries ClinicalEntry[]
  serviceOrders   ServiceOrder[]
  sales           Sale[]

  @@index([unitId])
}

// Foto do animal (tabela separada para não carregar os bytes nas listagens)
model PatientPhoto {
  patientId String   @id
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt
}

// ── Prontuário Clínico Geral ────────────────────────────────────
// Linha do tempo do paciente: atendimentos, anamnese, exames, peso, receitas...
model ClinicalEntry {
  id         String    @id @default(cuid())
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id])
  unitId     String
  unit       Unit      @relation(fields: [unitId], references: [id])
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  type       String
  title      String?
  content    String    @default("")
  weight     Float?
  // Tipo do atendimento (Aplicação CT, Retorno, C15...), retorno agendado, alta da internação, link de vídeo
  subtype    String?
  returnDate DateTime?
  endedAt    DateTime?
  videoUrl   String?
  occurredAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  attachments ClinicalAttachment[]

  @@index([patientId, occurredAt])
  @@index([unitId])
}

model ClinicalAttachment {
  id           String        @id @default(cuid())
  entryId      String
  entry        ClinicalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  createdAt    DateTime      @default(now())

  @@index([entryId])
}

// ── Prontuário Eletrônico ───────────────────────────────────────

model MedicalRecord {
  id             String  @id @default(cuid())
  serialNumber   String  @unique @default(cuid())
  patientId      String
  patient        Patient @relation(fields: [patientId], references: [id])
  unitId         String
  unit           Unit    @relation(fields: [unitId], references: [id])
  professionalId String
  professional   User    @relation(fields: [professionalId], references: [id])

  pathology        String
  cellQuantity     String?
  applicationRoute String?
  donors           String?
  serumCollected   Boolean @default(false)

  status      String    @default("OPEN")
  requestDate DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications            Application[]
  thawings                Thawing[]
  procedures              Procedure[]
  inventoryTransactions   InventoryTransaction[]
  serviceOrderApplication ServiceOrderApplication?
  attachments             MedicalRecordAttachment[]

  @@index([patientId])
  @@index([unitId])
  @@index([professionalId])
  @@index([status])
}

model Application {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  number          Int
  date            DateTime?
  cells           String?
  serum           String?
  medium          String?
  notes           String?
  // Quem preparou as células desta aplicação
  preparedBy      String?

  items ApplicationItem[]

  @@index([medicalRecordId])
}

// Lotes usados em cada aplicação (permite misturar lotes na mesma aplicação)
model ApplicationItem {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  batchId       String
  batch         CellBatch   @relation(fields: [batchId], references: [id])
  category      String
  quantity      Int

  @@index([applicationId])
  @@index([batchId])
}

model Thawing {
  id                String        @id @default(cuid())
  medicalRecordId   String
  medicalRecord     MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  number            Int
  thawedStraws      Int?
  thawedMeio        Int?
  thawedSoro        Int?
  retrievalLocation String?
  notes             String?

  @@index([medicalRecordId])
}

model Procedure {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  date            DateTime
  description     String
  observations    String?
  technician      String?

  @@index([medicalRecordId])
}

// ── Produtos Celulares e Lotes ──────────────────────────────────

model CellProduct {
  id          String   @id @default(cuid())
  name        String
  code        String?
  description String?
  species     String?
  category    String   @default("CELULAS")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  batches CellBatch[]
}

model CellBatch {
  id                String      @id @default(cuid())
  batchNumber       String
  productId         String
  product           CellProduct @relation(fields: [productId], references: [id])
  manufacturingDate DateTime?
  expirationDate    DateTime?
  totalStraws       Int
  storageConditions String?
  notes             String?
  createdAt         DateTime    @default(now())

  inventoryTransactions InventoryTransaction[]
  shipmentItems         ShipmentItem[]
  applicationItems      ApplicationItem[]

  @@index([productId])
}

// ── Estoque (Ledger de Movimentações) ───────────────────────────

model InventoryTransaction {
  id              String         @id @default(cuid())
  unitId          String
  unit            Unit           @relation(fields: [unitId], references: [id])
  batchId         String
  batch           CellBatch      @relation(fields: [batchId], references: [id])
  type            String
  quantity        Int
  balance         Int
  medicalRecordId String?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  shipmentId      String?
  reason          String?
  performedBy     String?
  createdAt       DateTime       @default(now())

  @@index([unitId])
  @@index([batchId])
  @@index([medicalRecordId])
  @@index([type])
}

// ── Limites de Estoque e Alertas ────────────────────────────────

model StockThreshold {
  id            String   @id @default(cuid())
  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id])
  productName   String
  minimumStraws Int
  createdAt     DateTime @default(now())

  @@unique([unitId, productName])
}

model Alert {
  id             String   @id @default(cuid())
  unitId         String
  unit           Unit     @relation(fields: [unitId], references: [id])
  type           String
  message        String
  // Alerta "OS aberta" (type SERVICE_ORDER): leva à OS
  serviceOrderId String?
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([unitId])
  @@index([resolved])
}

// ── Remessas (Matriz → Unidade) ─────────────────────────────────

model Shipment {
  id         String    @id @default(cuid())
  fromUnitId String
  fromUnit   Unit      @relation("ShipmentFrom", fields: [fromUnitId], references: [id])
  toUnitId   String
  toUnit     Unit      @relation("ShipmentTo", fields: [toUnitId], references: [id])
  status     String    @default("PENDING")
  shippedAt  DateTime?
  receivedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  items ShipmentItem[]

  @@index([fromUnitId])
  @@index([toUnitId])
}

model ShipmentItem {
  id         String    @id @default(cuid())
  shipmentId String
  shipment   Shipment  @relation(fields: [shipmentId], references: [id])
  batchId    String
  batch      CellBatch @relation(fields: [batchId], references: [id])
  quantity   Int

  @@index([shipmentId])
  @@index([batchId])
}

// ── Auditoria ───────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ── Contatos de Follow-up (C1 e C15 do verso do prontuário) ────

model FollowUpContact {
  id              String    @id @default(cuid())
  medicalRecordId String
  contactType     String
  date            DateTime?
  responsible     String?
  observations    String?
  createdAt       DateTime  @default(now())

  @@index([medicalRecordId])
}

// ── Ordem de Serviço (preparo das células) ──────────────────────
// Aberta por quem atende; quem prepara as células segue a OS e preenche o prontuário
model ServiceOrder {
  id            String   @id @default(cuid())
  serialNumber  String   @unique
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id])
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  clinic        String?
  city          String?
  disease       String?
  diagnosisTime String?
  checklist     String   @default("{}")
  cancelled     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications ServiceOrderApplication[]
  attachments  ServiceOrderAttachment[]

  @@index([patientId])
  @@index([unitId])
}

model ServiceOrderApplication {
  id               String         @id @default(cuid())
  serviceOrderId   String
  serviceOrder     ServiceOrder   @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  number           Int
  date             DateTime?
  veterinarian     String?
  financial        String?
  technicalNotes   String?
  // Orientações para quem prepara as células
  applicationRoute String?
  cellQuantity     String?
  preparation      String?
  status           String         @default("OPEN")
  // Veterinário clínico concluiu o pedido e avisou o laboratório (alerta "OS aberta")
  sentToLabAt      DateTime?
  medicalRecordId  String?        @unique
  medicalRecord    MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([serviceOrderId, number])
}

model ServiceOrderAttachment {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  checklistKey   String?
  fileName       String
  mimeType       String
  size           Int
  data           Bytes
  uploadedById   String
  createdAt      DateTime     @default(now())

  @@index([serviceOrderId])
}

// Fotos das palhetas (antes coladas no prontuário de papel)
model MedicalRecordAttachment {
  id              String        @id @default(cuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  size            Int
  data            Bytes
  uploadedById    String
  createdAt       DateTime      @default(now())

  @@index([medicalRecordId])
}

// ── Orçamentos e Vendas ─────────────────────────────────────────
// Orçamento do paciente; aprovado, vira venda (mesmo registro) com a forma de pagamento
// e gera o documento para o financeiro. Valores em centavos
model Sale {
  id            String    @id @default(cuid())
  number        Int       @unique @default(autoincrement())
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id])
  unitId        String
  unit          Unit      @relation(fields: [unitId], references: [id])
  createdById   String
  createdBy     User      @relation("SaleCreatedBy", fields: [createdById], references: [id])
  // QUOTE (orçamento), SALE (venda) ou CANCELLED
  status        String    @default("QUOTE")
  validUntil    DateTime?
  notes         String?
  discount      Int       @default(0)
  // Preenchidos na conversão em venda
  soldAt        DateTime?
  soldById      String?
  soldBy        User?     @relation("SaleSoldBy", fields: [soldById], references: [id])
  paymentMethod String?
  installments  Int?
  paymentNotes  String?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items SaleItem[]

  @@index([patientId])
  @@index([unitId])
  @@index([status])
}

// Tabela de preços (só a matriz edita): com valor, o item entra no orçamento com preço travado;
// sem valor, só aparece na busca e o preço fica livre. Valores em centavos
model PriceItem {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleItem {
  id          String @id @default(cuid())
  saleId      String
  sale        Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Int
  unitPrice   Int

  @@index([saleId])
  @@index([description])
}
